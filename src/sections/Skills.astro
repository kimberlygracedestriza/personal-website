---
/* SECTION: toolbox. Draggable skill stickers on a dotted board, with a Shuffle button.
   Remove: delete its line in src/config/sections.ts (and this file). */
import Squiggle from '../components/Squiggle.astro'
import Wave from '../components/Wave.astro'

interface Props { id: string }
const { id } = Astro.props

const skills = [
  'WordPress', 'Elementor', 'Gutenberg', 'WooCommerce', 'Figma', 'HTML', 'CSS', 'JavaScript',
  'PHP', 'Yoast SEO', 'Canva', 'Divi', 'ACF', 'cPanel', 'Google Analytics', 'Mailchimp',
  'Web Design', 'UI/UX', 'Branding', 'Copywriting',
]
const tones = ['rose', 'white', 'blush', 'ink', 'white', 'blush']
---
<section class="skills section tint" id={id}>
  <Wave flip />
  <div class="wrap">
    <div class="sec-head sk-head">
      <div>
        <span class="pill">My toolbox</span>
        <h2 class="h2">Things I'm <span class="hl">good at<Squiggle /></span></h2>
      </div>
      <div class="sk-side">
        <p class="note sec-note">psst, these stickers are draggable</p>
        <button class="btn btn-line sk-shuffle">Shuffle</button>
      </div>
    </div>
    <div class="sk-board">
      {skills.map((s, i) => <span class={`skill tone-${tones[i % tones.length]}`}>{s}</span>)}
    </div>
  </div>
</section>

<style>
  .sk-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .sk-side { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .sk-side .sec-note { margin: 0; }
  .sk-board {
    position: relative; border-radius: 36px; background-color: var(--blush-soft); overflow: hidden;
    background-image: radial-gradient(rgba(185, 121, 139, 0.3) 1.5px, transparent 1.5px); background-size: 22px 22px;
    border: 2px dashed rgba(185, 121, 139, 0.45);
  }
  .skill {
    position: absolute; padding: 11px 20px; border-radius: 14px; font-weight: 700; font-size: var(--fs-base); white-space: nowrap;
    border: 3px solid var(--surface); box-shadow: 0 10px 22px -10px rgba(58, 42, 47, 0.35); cursor: grab; user-select: none; touch-action: none;
  }
  .skill:active { cursor: grabbing; }
  .sk-board.flow { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; padding: 26px 16px; }
  .sk-board.flow .skill { position: relative; left: auto !important; top: auto !important; }
  .tone-rose { background: var(--rose); color: var(--on-rose); }
  .tone-white { background: var(--surface); color: var(--ink); }
  .tone-blush { background: var(--blush); color: var(--ink); }
  .tone-ink { background: var(--ink); color: var(--blush-soft); }

  @media (max-width: 760px) { .sk-side { align-items: flex-start; } }
</style>

<script>
  import { gsap, Draggable } from '../lib/motion'
  const board = document.querySelector<HTMLElement>('.sk-board')!

  function layout(animate: boolean) {
    const els = [...board.querySelectorAll<HTMLElement>('.skill')]
    const flow = innerWidth < 700
    board.classList.toggle('flow', flow)
    if (flow) {
      board.style.height = ''
      if (animate) els.sort(() => Math.random() - 0.5).forEach((el) => board.appendChild(el))
      els.forEach((el, k) => gsap.to(el, { x: 0, y: 0, xPercent: 0, yPercent: 0, rotate: animate ? gsap.utils.random(-8, 8) : ((k * 29) % 13) - 6, duration: animate ? 0.8 : 0, ease: 'elastic.out(1, 0.6)' }))
      return
    }
    const cols = innerWidth < 1100 ? 4 : 5
    const rowH = 92
    board.style.height = `${Math.ceil(els.length / cols) * rowH + 60}px`
    const order = els.map((_, i) => i)
    if (animate) order.sort(() => Math.random() - 0.5)
    els.forEach((el, k) => {
      const idx = order[k], c = idx % cols, r = Math.floor(idx / cols)
      const jx = animate ? gsap.utils.random(-1.5, 1.5) : (((k * 37) % 7) - 3) * 0.5
      const jy = animate ? gsap.utils.random(-12, 12) : ((k * 53) % 21) - 10
      gsap.to(el, {
        left: `${8 + ((c + 0.5) / cols) * 84 + jx}%`, top: `${30 + (r + 0.5) * rowH + jy * 0.6}px`,
        x: 0, y: 0, xPercent: -50, yPercent: -50, rotate: animate ? gsap.utils.random(-14, 14) : ((k * 29) % 19) - 9,
        duration: animate ? 1.1 : 0, ease: 'elastic.out(1, 0.6)', delay: animate ? k * 0.015 : 0,
      })
    })
  }
  layout(false)
  addEventListener('resize', () => layout(false))
  document.querySelector('.sk-shuffle')!.addEventListener('click', () => layout(true))
  gsap.from('.skill', { scale: 0, stagger: { each: 0.03, from: 'random' }, duration: 0.7, ease: 'back.out(2.6)', scrollTrigger: { trigger: board, start: 'top 80%' } })
  Draggable.create('.skill', {
    bounds: board,
    onPress() { gsap.to(this.target, { scale: 1.15, rotate: 0, zIndex: 5, duration: 0.2 }) },
    onRelease() { gsap.to(this.target, { scale: 1, rotate: gsap.utils.random(-12, 12), zIndex: 1, duration: 0.6, ease: 'elastic.out(1, 0.5)' }) },
  })
</script>
