---
/* SECTION: hero. Name, intro, stats, buttons, portrait, background word, mesh gradient.
   Remove: delete its line in src/config/sections.ts (and this file). */
import { site } from '../config/site'
import Squiggle from '../components/Squiggle.astro'
import HeroMesh from '../features/HeroMesh.astro'

interface Props { id: string }
const { id } = Astro.props

const bgWord = 'WORDPRESS DEVELOPER'
const intro = 'I design and build clear, fast websites for small businesses and service providers, from the first sketch to launch day.'
const counts = [
  { value: '40+', label: 'sites launched' },
  { value: '3', label: 'years freelancing' },
  { value: '3', label: 'time zones' },
]
const booking = site.booking
  ? { href: site.booking, target: '_blank', rel: 'noreferrer' }
  : { href: '#contact' }
---
<section class="hero" id={id}>
  <HeroMesh />
  <p class="hr-bgword" aria-hidden="true">{bgWord}</p>
  <div class="hr-grid">
    <div class="hr-copy">
      <p class="hr-hello note">Hi there, I'm</p>
      <h1 class="hr-name">
        {site.name.split('').map((c) => <span class="ch-mask"><span class="ch">{c === ' ' ? ' ' : c}</span></span>)}
        <Squiggle manual />
      </h1>
      <p class="hr-sub">
        <b>{site.role}</b>
        <svg class="spark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c.8 6.4 3.6 9.6 12 12-8.4 2.4-11.2 5.6-12 12-.8-6.4-3.6-9.6-12-12C8.4 9.6 11.2 6.4 12 0z" /></svg>
        {intro}
      </p>
      <ul class="hr-counts" aria-label="Highlights">
        {counts.map((c) => <li><b>{c.value}</b><span>{c.label}</span></li>)}
      </ul>
      <div class="hr-ctas">
        <a class="btn btn-rose" {...booking}>Book a discovery call</a>
        <a class="btn btn-line" href="#work">See my works</a>
      </div>
    </div>
    <div class="hr-visual">
      <div class="hr-blob"></div>
      <img class="hr-person" src={site.photo} alt={`Portrait of ${site.name}`} />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-top: 110px; padding-bottom: 40px; overflow: hidden; }
  .hr-bgword { position: absolute; left: 50%; top: 30%; translate: -50% -50%; z-index: 0; margin: 0; white-space: nowrap; pointer-events: none; user-select: none; font-family: var(--display); font-weight: 800; font-size: 7.5vw; line-height: 1; letter-spacing: -0.03em; color: var(--rose); opacity: 0.1; }
  .hr-grid { position: relative; z-index: 1; max-width: 1240px; margin: 0 auto; padding-inline: var(--gx); display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 2vw; align-items: end; min-height: calc(100svh - 110px); }
  .hr-copy { padding-bottom: 9vh; }
  .hr-hello { line-height: 1; margin: 0 0 8px 0.1em; }
  .hr-name { position: relative; display: inline-block; white-space: nowrap; font-family: var(--display); font-weight: 800; font-size: var(--fs-xl); line-height: 0.95; letter-spacing: -0.04em; margin: 0 0 26px -0.04em; }
  .hr-name :global(.squiggle) { bottom: -0.08em; height: 0.16em; }
  .hr-name :global(.squiggle path) { stroke-width: 6; }
  .ch-mask { display: inline-block; overflow: hidden; padding: 0.04em 0.01em 0.06em; margin: -0.04em -0.01em -0.06em; }
  .ch { display: inline-block; }
  .hr-sub { max-width: 30em; color: var(--muted); }
  .hr-sub b { color: var(--ink); font-weight: 700; }
  .spark { width: 0.8em; height: 0.8em; display: inline-block; vertical-align: -0.05em; fill: var(--rose); margin: 0 4px; }
  .hr-counts { display: flex; gap: clamp(22px, 3vw, 44px); margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line); max-width: 30em; }
  .hr-counts li { display: flex; flex-direction: column; }
  .hr-counts b { font-family: var(--display); font-weight: 800; font-size: var(--fs-md); line-height: 1.2; }
  .hr-counts span { font-size: var(--fs-xs); color: var(--muted); }
  .hr-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hr-visual { position: relative; height: min(86vh, 840px); clip-path: inset(-40% -40% 0 -40%); }
  .hr-visual::before { content: ''; position: absolute; left: 50%; bottom: 8%; width: 95%; aspect-ratio: 1; translate: -50% 0; border-radius: 50%; background: radial-gradient(circle, rgba(185, 121, 139, 0.3), rgba(185, 121, 139, 0) 65%); pointer-events: none; }
  .hr-blob {
    position: absolute; left: 4%; right: 4%; bottom: 0; height: 72%; background: var(--blush-soft);
    border-radius: 48% 52% 0 0 / 55% 50% 0 0; animation: blob 12s ease-in-out infinite alternate;
    box-shadow: inset 0 -40px 80px -40px rgba(185, 121, 139, 0.3);
  }
  .hr-blob::before { content: ''; position: absolute; inset: 9% 12% auto auto; width: 22%; aspect-ratio: 1; border-radius: 50%; background: var(--blush); }
  @keyframes blob { 50% { border-radius: 56% 44% 0 0 / 48% 58% 0 0; } 100% { border-radius: 44% 56% 0 0 / 60% 46% 0 0; } }
  .hr-person { position: absolute; left: 50%; bottom: -14px; height: 92%; width: auto; max-width: none; translate: -50% 0; transform-origin: 50% 100%; filter: drop-shadow(0 26px 34px rgba(185, 121, 139, 0.35)); }

  @media (max-width: 760px) {
    .hero { padding-top: 96px; }
    .hr-grid { grid-template-columns: 1fr; min-height: 0; gap: 10px; }
    .hr-name { margin: 10px 0 18px; }
    .hr-visual { height: 60vh; margin-top: 18px; }
    .hr-copy { padding-bottom: 0; }
  }
</style>

<script>
  import { gsap, onReady } from '../lib/motion'

  onReady(() => {
    gsap.timeline()
      .from('.hr-hello', { y: 20, opacity: 0, duration: 0.8 })
      .from('.hr-name .ch', { yPercent: 110, rotate: 8, stagger: 0.05, duration: 1.1 }, 0.1)
      .to('.hr-name .squiggle path', { strokeDashoffset: 0, duration: 1.2, ease: 'power2.inOut' }, 0.6)
      .from('.hr-sub, .hr-counts, .hr-ctas', { y: 30, opacity: 0, stagger: 0.1, duration: 1 }, 0.4)
      .from('.hr-blob', { scale: 0.6, opacity: 0, duration: 1.4, ease: 'elastic.out(1, 0.7)' }, 0.1)
      .from('.hr-person', { yPercent: 30, opacity: 0, duration: 1.2, ease: 'back.out(1.4)' }, 0.3)
  })

  // portrait leans toward the cursor
  const person = document.querySelector<HTMLElement>('.hr-person')!
  const lean = gsap.quickTo(person, 'rotation', { duration: 0.8, ease: 'power3.out' })
  const shift = gsap.quickTo(person, 'x', { duration: 0.8, ease: 'power3.out' })
  addEventListener('pointermove', (e) => {
    const r = person.getBoundingClientRect()
    const k = gsap.utils.clamp(-1, 1, (e.clientX - (r.left + r.width / 2)) / (r.width * 1.1))
    lean(k * 6); shift(k * 14)
  })
  document.addEventListener('pointerleave', () => { lean(0); shift(0) })
  gsap.to('.hr-visual', { yPercent: -8, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true } })
</script>
