---
/* SECTION: about. Clickable photo stack (one role per photo), two paragraphs, four stat cards.
   Remove: delete its line in src/config/sections.ts (and this file). */
import { site } from '../config/site'
import Squiggle from '../components/Squiggle.astro'
import Wave from '../components/Wave.astro'

interface Props { id: string }
const { id } = Astro.props

const cards = [
  { photo: '/img/photo-1.svg', role: 'Web Designer' },
  { photo: '/img/photo-2.svg', role: 'WordPress Developer' },
  { photo: '/img/photo-3.svg', role: 'Automation Specialist' },
  { photo: '/img/photo-4.svg', role: 'In Progress Full Stack Developer' },
]
const paragraphs = [
  `Hi! I'm ${site.name}, a freelance Web Designer and WordPress Developer working across EST, PHT and Australian time (AEST).`,
  'I help small businesses and service providers get websites for online presence, set up dashboard & portal, load fast and are easy to update on their own.',
]
const stats = [
  { value: '8', label: 'Websites launched' },
  { value: '100+', label: 'Websites managed and QA checked' },
  { value: '8', label: 'Happy clients' },
  { value: '3', label: 'Years freelancing' },

]
---
<section class="about section tint" id={id}>
  <Wave />
  <div class="wrap ab-grid">
    <div class="stack" role="button" tabindex="0" aria-label="Shuffle photos">
      {cards.map((c, i) => (
        <figure class:list={['stack-card', { 'is-top': i === 0 }]} data-i={i} style={`--pos:${i};z-index:${10 - i}`}>
          <img src={c.photo} alt={`${site.name}, ${c.role}`} loading="lazy" />
          <figcaption><span class="role-kicker">I'm a</span><span class="role-name">{c.role}</span></figcaption>
        </figure>
      ))}
      <span class="stack-hint note">click to see my other roles</span>
    </div>
    <div class="ab-copy">
      <span class="pill">About me</span>
      <h2 class="h2">A little <span class="hl">about me<Squiggle /></span></h2>
      {paragraphs.map((p) => <p class="lead">{p}</p>)}
      <div class="ab-stats">
        {stats.map((s) => <div class="ab-stat"><b>{s.value}</b><span>{s.label}</span></div>)}
      </div>
    </div>
  </div>
</section>

<style>
  .ab-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
  .stack { position: relative; width: min(100%, 400px); min-height: 480px; align-self: stretch; justify-self: center; margin: 12vh 0 3vh; cursor: pointer; outline: none; }
  .stack-card {
    position: absolute; inset: 0 0 8% 0; margin: 0; padding: 12px 12px 70px; background: var(--surface); border-radius: 18px; box-shadow: var(--shadow);
    rotate: calc(var(--pos) * 5deg - 4deg); translate: calc(var(--pos) * 14px) calc(var(--pos) * 8px);
    transition: rotate 0.6s var(--ease), translate 0.6s var(--ease);
  }
  .stack-card img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; border-radius: 10px; }
  .stack-card figcaption { position: absolute; left: 0; right: 0; bottom: 12px; text-align: center; transition: opacity 0.3s; }
  .stack-card:not(.is-top) figcaption { opacity: 0; }
  .role-kicker { display: block; font-family: var(--display); font-style: italic; font-size: var(--fs-xs); color: var(--rose-d); }
  .role-name { display: inline-block; font-family: var(--display); font-weight: 800; font-size: var(--fs-md); color: var(--ink); }
  .stack-hint { position: absolute; z-index: 20; right: 0; bottom: -44px; rotate: -3deg; white-space: nowrap; }
  .ab-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 34px; }
  .ab-stat { padding: 22px; border-radius: 22px; background: var(--surface); display: flex; flex-direction: column; gap: 2px; transition: translate 0.4s var(--ease), rotate 0.4s var(--ease), background 0.4s; }
  .ab-stat:hover { translate: 0 -4px; rotate: -1deg; background: var(--blush-soft); }
  .ab-stat b { font-family: var(--display); font-weight: 800; font-size: var(--fs-lg); line-height: 1; color: var(--rose-d); }
  .ab-stat span { font-size: var(--fs-xs); color: var(--muted); font-weight: 500; }

  @media (max-width: 760px) {
    .stack { width: 82%; min-height: 0; aspect-ratio: 4 / 5.2; align-self: center; margin: 0 auto 50px; }
    .ab-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { gsap } from '../lib/motion'
  const stack = document.querySelector<HTMLElement>('.stack')!
  const cards = [...stack.querySelectorAll<HTMLElement>('.stack-card')]
  let order = cards.map((_, i) => i)
  const paint = () => cards.forEach((el) => {
    const pos = order.indexOf(+el.dataset.i!)
    el.style.zIndex = String(10 - pos)
    el.style.setProperty('--pos', String(pos))
    el.classList.toggle('is-top', pos === 0)
  })
  const next = () => {
    const top = cards[order[0]]
    gsap.timeline()
      .to(top, { x: 260, y: -40, rotate: 18, duration: 0.35, ease: 'power2.in' })
      .add(() => { order = [...order.slice(1), order[0]]; paint() })
      .to(top, { x: 0, y: 0, rotate: 0, duration: 0.5, ease: 'back.out(1.6)' })
  }
  stack.addEventListener('click', next)
  stack.addEventListener('keydown', (e) => e.key === 'Enter' && next())
  gsap.from(cards, { y: 80, opacity: 0, stagger: 0.12, duration: 1.1, ease: 'back.out(1.4)', scrollTrigger: { trigger: '.about', start: 'top 72%' } })
  gsap.from('.ab-copy > *', { y: 40, opacity: 0, stagger: 0.1, duration: 1.1, scrollTrigger: { trigger: '.ab-copy', start: 'top 80%' } })
  gsap.from('.ab-stat', { y: 40, opacity: 0, scale: 0.9, stagger: 0.08, duration: 0.9, ease: 'back.out(1.8)', scrollTrigger: { trigger: '.ab-stats', start: 'top 88%' } })
</script>
