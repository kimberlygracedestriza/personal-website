---
/* FEATURE: top navigation. Full bar at the top, shrinks into a pill on scroll. Burger menu on mobile.
   Links come from src/config/sections.ts (any section with a `nav` label).
   Remove: delete <Nav /> in src/pages/index.astro and this file. */
import { site } from '../config/site'
import { sections } from '../config/sections'
import ThemeToggle from './ThemeToggle.astro'

const links = sections.filter((s) => s.nav).map((s) => ({ label: s.nav!, href: `#${s.id}` }))
---
<header class="nav" id="nav">
  <a href="#top" class="nav-brand"><img src={site.avatar} alt="" /><span>{site.name.toUpperCase()}<em>.</em></span></a>
  <nav class="nav-links" aria-label="Primary">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <ThemeToggle />
  <a href="#contact" class="btn btn-rose nav-cta">Let's chat</a>
  <button class="nav-burger" aria-expanded="false" aria-label="Menu"><i></i><i></i></button>
  <div class="nav-sheet">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href="#contact">Contact</a>
  </div>
</header>

<style>
  .nav {
    position: fixed; z-index: 100; top: 14px; left: 50%; translate: -50% 0; width: min(1200px, calc(100% - 24px));
    display: flex; align-items: center; gap: 24px; height: 66px; padding: 0 10px 0 12px; border-radius: 99px;
    border: 1px solid transparent;
    transition: width 0.6s var(--ease), height 0.6s var(--ease), top 0.6s var(--ease), padding 0.6s var(--ease), gap 0.6s var(--ease), background 0.4s, box-shadow 0.4s, border-color 0.4s;
  }
  .nav.is-open, .nav.is-pill { background: var(--nav-glass); backdrop-filter: blur(16px) saturate(1.4); border-color: var(--line); box-shadow: var(--shadow); }
  /* scrolled: shrink into a pill. Every control is the same 40px height. */
  .nav.is-pill { top: 10px; width: min(900px, calc(100% - 24px)); height: 56px; padding: 0 7px; gap: 20px; }
  .nav-brand img, .nav-cta, .nav-burger { transition: width 0.6s var(--ease), height 0.6s var(--ease), transform 0.35s var(--ease), background 0.35s; }
  .nav.is-pill .nav-burger { width: 40px; height: 40px; }
  .nav.is-pill .nav-cta { height: 40px; }
  .nav-brand { display: inline-flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 800; font-size: var(--fs-md); letter-spacing: -0.02em; margin-right: auto; }
  .nav-brand img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid var(--rose); }
  .nav-brand em { color: var(--rose); font-style: normal; }
  .nav-links { display: flex; gap: 26px; font-weight: 500; color: var(--muted); }
  .nav-links a { position: relative; transition: color 0.3s; }
  .nav-links a::after { content: ''; position: absolute; left: 50%; bottom: -8px; width: 5px; height: 5px; border-radius: 50%; background: var(--rose); transform: translateX(-50%) scale(0); transition: transform 0.35s var(--ease); }
  .nav-links a:hover { color: var(--ink); }
  .nav-links a:hover::after { transform: translateX(-50%) scale(1); }
  .nav-cta { height: 46px; padding: 0 20px; }
  .nav-burger { display: none; width: 46px; height: 46px; border-radius: 50%; background: var(--rose); flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
  .nav-burger i { width: 16px; height: 2px; border-radius: 2px; background: var(--on-rose); transition: transform 0.35s var(--ease); }
  .is-open .nav-burger i:first-child { transform: translateY(3.5px) rotate(45deg); }
  .is-open .nav-burger i:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .nav-sheet { display: none; }

  @media (max-width: 1000px) { .nav-links { display: none; } }
  @media (max-width: 760px) {
    .nav-cta { display: none; }
    .nav-burger { display: flex; }
    .nav { flex-wrap: wrap; height: auto; min-height: 62px; border-radius: 30px; }
    .nav.is-pill { height: auto; min-height: 56px; border-radius: 30px; padding-block: 7px; }
    .nav-sheet { display: flex; flex-direction: column; width: 100%; max-height: 0; overflow: hidden; transition: max-height 0.5s var(--ease); }
    .is-open .nav-sheet { max-height: 360px; padding-bottom: 10px; }
    .nav-sheet a { font-family: var(--display); font-weight: 800; font-size: var(--fs-md); padding: 8px 10px; border-top: 1px solid var(--line); }
  }
</style>

<script>
  import { gsap, getLenis, onReady } from '../lib/motion'
  const nav = document.getElementById('nav')!
  const burger = nav.querySelector('.nav-burger')!
  getLenis().on('scroll', ({ scroll }: { scroll: number }) => nav.classList.toggle('is-pill', scroll > 80))
  burger.addEventListener('click', () => burger.setAttribute('aria-expanded', String(nav.classList.toggle('is-open'))))
  addEventListener('site:navigate', () => nav.classList.remove('is-open'))
  onReady(() => gsap.from(nav, { y: -80, opacity: 0, duration: 1.1, delay: 0.3 }))
</script>
